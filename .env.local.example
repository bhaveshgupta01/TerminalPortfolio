# Local env vars (copy to .env.local). Never commit the real file.

# Chat on the home page. Create a key at https://console.anthropic.com
# In production, set the same variable in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=

# Optional: which Claude model answers. Defaults to claude-opus-5-5.
# CHAT_MODEL=claude-haiku-5-5

# Optional: durable question log + shared rate limit (Upstash Redis REST).
# Vercel's "Upstash for Redis" integration sets these two automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Password for the private log page at /api/questions?key=...
# ADMIN_KEY=

# Only used by the archived versions (/v1, /v2, /wallet, /lab): URL of the old
# FastAPI agent in backend/. Leave unset unless you run that server.
# VITE_AGENT_API=http://localhost:8000
